{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smsinbox",
  "main": "src/index.ts",
  // 2026-10-30 is the newest date this Wrangler's workerd accepts. 2026-10-31 is rejected as future.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  // database_id 可留空：当前 Wrangler 的配置校验不强制填写。
  // 远程部署前运行 `npx wrangler d1 create smsinbox`，把返回的 UUID 填到 database_id。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smsinbox",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 3 * * *"]
  },
  "vars": {
    "RETENTION_DAYS": "90",
    "CONTENT_KEY": ""
  },
  "secrets": {
    "required": ["ADMIN_USERNAME", "ADMIN_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
